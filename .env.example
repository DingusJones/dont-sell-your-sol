# Server only. Leave blank for explicit unavailable live coverage.
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK_URL=
# Enable only for controlled verification; not a claim of production coverage.
ENABLE_RPC=false

# Optional server-only Jupiter Price V3 binding. Never use a VITE_ prefix.
# Both flag=true and an API key are required; blank means unavailable prices.
ENABLE_LIVE_PRICES=false
JUPITER_API_KEY=
