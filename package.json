{
  "name": "dont-sell-your-sol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "build": "vite build --config apps/web/vite.config.ts && esbuild apps/api/src/index.ts --bundle --platform=neutral --format=esm --outfile=dist/api/worker.js",
    "preview": "vite preview --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@tanstack/react-query": "5.101.2",
    "zod": "4.4.3",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "@vitejs/plugin-react": "6.0.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.20.1",
    "vitest": "4.1.10",
    "@playwright/test": "1.58.2",
    "esbuild": "0.28.1"
  }
}
